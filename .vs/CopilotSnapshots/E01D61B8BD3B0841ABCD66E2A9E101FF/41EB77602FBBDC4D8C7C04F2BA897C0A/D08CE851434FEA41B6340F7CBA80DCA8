namespace APProjetSport
{
    public partial class Form1 : Form
    {
        
        private List<Sportif> tousLesSportifs = new List<Sportif>();

        public Form1()
        {
            InitializeComponent();
        }



        private void listResultat_SelectedIndexChanged(object sender, EventArgs e)
        {
            if (listResultat.SelectedItems.Count > 0)
            {
                int indexSelectionne = listResultat.SelectedIndices[0];
                Sportif sportifSelectionne = tousLesSportifs[indexSelectionne];

                string message = $"Informations du sportif :\n\n" +
                                 $"Nom : {sportifSelectionne.Nom}\n" +
                                 $"Prénom : {sportifSelectionne.Prenom}\n" +
                                 $"Date de naissance : {sportifSelectionne.DateNais.ToShortDateString()}\n" +
                                 $"Rue : {sportifSelectionne.Rue}\n" +
                                 $"Ville : {sportifSelectionne.Ville}\n" +
                                 $"Code postal : {sportifSelectionne.CodePostal}\n" +
                                 $"Niveau d'expérience : {sportifSelectionne.NivExpercience}\n" +
                                 $"Sport : {sportifSelectionne.NomSport}";

                MessageBox.Show(message, "Détails du sportif");
            }
        }

        private void CbListeDeroulante_SelectedIndexChanged(object sender, EventArgs e)
        {
            if (CbListeDeroulante.SelectedItem != null)
            {
                string selection = CbListeDeroulante.SelectedItem.ToString();

                // Diviser la sélection en ses composantes (Ville - NivExpercience - NomSport)
                string[] parties = selection.Split(new string[] { " - " }, StringSplitOptions.None);

                if (parties.Length == 3)
                {
                    string villeFiltree = parties[0];
                    string niveauFiltre = parties[1];
                    string sportFiltre = parties[2];

                    // Filtrer les sportifs correspondant à cette combinaison
                    List<Sportif> resultats = new List<Sportif>();

                    for (int i = 0; i < tousLesSportifs.Count; i++)
                    {
                        Sportif sportif = tousLesSportifs[i];

                        if (sportif.Ville == villeFiltree 
                            && sportif.NivExpercience == niveauFiltre 
                            && sportif.NomSport == sportFiltre)
                        {
                            resultats.Add(sportif);
                        }
                    }

                    AfficherResultats(resultats);
                }
            }
        }

        private void Form1_Load(object sender, EventArgs e)
        {
            // Configuration de la ListView
            listResultat.View = View.Details;
            listResultat.FullRowSelect = true;
            listResultat.GridLines = true;

            listResultat.Columns.Clear();
            listResultat.Columns.Add("Nom", 100);
            listResultat.Columns.Add("Prénom", 100);
            listResultat.Columns.Add("Date de naissance", 100);
            listResultat.Columns.Add("Rue", 120);
            listResultat.Columns.Add("Code Postal", 80);
            listResultat.Columns.Add("Ville", 80);
            listResultat.Columns.Add("Niveau", 100);
            listResultat.Columns.Add("Sport", 100);

            // Récupération des données
            tousLesSportifs = GSportif.GetAll();

            // Afficher tous les sportifs
            AfficherResultats(tousLesSportifs);

            // Remplir la ComboBox
            List<string> filtres = new List<string>();
            for (int i = 0; i < tousLesSportifs.Count; i++)
            {
                string filtre = tousLesSportifs[i].Ville + " - " + tousLesSportifs[i].NivExpercience + " - " + tousLesSportifs[i].NomSport;

                bool existe = false;
                for (int j = 0; j < filtres.Count; j++)
                {
                    if (filtres[j] == filtre)
                        existe = true;
                }

                if (!existe)
                    filtres.Add(filtre);
            }

            CbListeDeroulante.DataSource = filtres;
        }

        private void AfficherResultats(List<Sportif> sportifs)
        {
            listResultat.Items.Clear();
            for (int i = 0; i < sportifs.Count; i++)
            {
                Sportif sportif = sportifs[i];

                ListViewItem item = new ListViewItem(sportif.Nom);

                item.SubItems.Add(sportif.Prenom);
                item.SubItems.Add(sportif.DateNais.ToShortDateString());
                item.SubItems.Add(sportif.Rue);
                item.SubItems.Add(sportif.Ville);
                item.SubItems.Add(sportif.CodePostal);
                item.SubItems.Add(sportif.NivExpercience);
                item.SubItems.Add(sportif.NomSport);

                listResultat.Items.Add(item);
            }
        }

        private void textZoneRecherchee_TextChanged(object sender, EventArgs e)
        {
            string recherche = textZoneRecherchee.Text;

        }

        private void BtnRechercher_Click(object sender, EventArgs e)
        {
            string motRecherche = textZoneRecherchee.Text.Trim().ToLower();

            // Si le champ est vide, on réaffiche tout
            if (motRecherche == "")
            {
                AfficherResultats(tousLesSportifs);
                return;
            }

            List<Sportif> resultats = new List<Sportif>();

            for (int i = 0; i < tousLesSportifs.Count; i++)
            {
                Sportif sportif = tousLesSportifs[i];

                bool correspond = sportif.Nom.ToLower().Contains(motRecherche)
                                || sportif.Prenom.ToLower().Contains(motRecherche)
                                || sportif.Ville.ToLower().Contains(motRecherche)
                                || sportif.NivExpercience.ToLower().Contains(motRecherche)
                                || sportif.NomSport.ToLower().Contains(motRecherche)
                                || sportif.Rue.ToLower().Contains(motRecherche)
                                || sportif.CodePostal.ToLower().Contains(motRecherche);

                if (correspond)
                {
                    resultats.Add(sportif);
                }
            }

            AfficherResultats(resultats);
        }
    }
    
}


