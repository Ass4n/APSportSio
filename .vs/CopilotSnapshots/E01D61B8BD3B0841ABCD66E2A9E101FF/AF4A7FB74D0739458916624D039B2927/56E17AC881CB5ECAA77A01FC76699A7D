    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        private void LoadComboBoxData()
        {
            try
            {
                List<Sportif> sportifs = GSportif.GetAll();

                // Créer une liste de chaînes de caractères avec les trois attributs
                List<string> donnees = new List<string>();

                foreach (Sportif sportif in sportifs)
                {
                    string item = $"{sportif.Ville} - {sportif.NivExpercience} - {sportif.NomSport}";
                    if (!donnees.Contains(item))
                    {
                        donnees.Add(item);
                    }
                }

                CbListeDeroulante.DataSource = donnees;
            }
            catch (Exception ex)
            {
                MessageBox.Show("Erreur lors du chargement des données : " + ex.Message);
            }
        }


        private void listResultat_SelectedIndexChanged(object sender, EventArgs e)
        {

        }

        private void CbListeDeroulante_SelectedIndexChanged(object sender, EventArgs e)
        {

        }

        private void Form1_Load(object sender, EventArgs e)
        {
            LoadComboBoxData();
        }

    }
}

